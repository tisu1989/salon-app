NODE_ENV=test
PORT=4099

# Separate database from dev - integration tests truncate all tables before
# every test, which would be destructive against real dev data.
DATABASE_URL="mysql://root:rootpass@localhost:3308/salon_app_test"

# Separate logical Redis DB (index 1, not dev's 0) - keeps rate-limit counters
# and WhatsApp sessions from leaking between test runs and dev.
REDIS_URL="redis://localhost:6379/1"

JWT_ACCESS_SECRET=test_access_secret
JWT_REFRESH_SECRET=test_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
