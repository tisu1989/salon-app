NODE_ENV=development
PORT=4000

DATABASE_URL="mysql://salon:salonpass@localhost:3306/salon_app"

REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# WhatsApp (Meta Cloud API test number) - fill in once created
WHATSAPP_VERIFY_TOKEN=change_me_webhook_verify_token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Browser origins allowed to call the API (comma-separated). Unset = local Vite ports in
# dev/test, and NO cross-origin access in production - set this to your real frontend URL.
CORS_ORIGINS=http://localhost:5183,http://localhost:5173

# Number of reverse proxies in front of the API (e.g. 1 on Render/Fly). Makes req.ip the real
# client for login lockout and rate limits. Leave unset when the API is exposed directly.
# TRUST_PROXY=1
